# Скопируйте в .env и подставьте свои значения. Этот файл в репозиторий с пустыми полями.

PROXYAPI_KEY=
PROXYAPI_BASE_URL=https://api.proxyapi.ru/v1
PROXYAPI_MODEL=qwen/qwen3.8-flash

VK_GROUP_TOKEN=
VK_GROUP_ID=
VK_API_VERSION=5.199
VK_MANAGER_IDS=

PORT=3000
NODE_ENV=development
# Список сохранённых диалогов выключен. Включать только локально: ALLOW_DIALOGS_API=1
ALLOW_DIALOGS_API=
SESSION_SECRET=
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
WIDGET_API_KEY=
MAX_HISTORY_MESSAGES=12
